----------------------------------------------------------------------
-- window: theme
----------------------------------------------------------------------
function Window:_bind(inst, prop, key)
	inst[prop] = self.Theme[key]
	local m = self._themed[inst]
	if not m then
		m = {}
		self._themed[inst] = m
	end
	m[prop] = key
	return inst
end

function Window:_applyTheme()
	for inst, props in pairs(self._themed) do
		for prop, key in pairs(props) do
			inst[prop] = self.Theme[key]
		end
	end
	for _, h in ipairs(self._hooks) do fire(h) end
end

function Window:_hook(fn)
	self._hooks[#self._hooks + 1] = fn
end

function Window:_label(parent, text, props)
	props = props or {}
	local l = new("TextLabel", {
		BackgroundTransparency = 1,
		Position = props.Position or UDim2.fromOffset(12, 0),
		Size = props.Size or UDim2.new(1, -24, 1, 0),
		Text = text,
		Font = props.Font or F.Regular,
		TextSize = props.TextSize or M.Text,
		TextXAlignment = props.Align or Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = parent,
	})
	self:_bind(l, "TextColor3", props.Color or "Text")
	return l
end

function Window:SetTheme(name)
	local base = Themes[name]
	if not base then return false end
	self.ThemeName = name
	self.Theme = copyTheme(base)
	self:_applyTheme()
	return true
end

function Window:SetAccent(c)
	self.Theme.Accent = c
	self:_applyTheme()
end

----------------------------------------------------------------------
-- window: layout + input
----------------------------------------------------------------------
function Window:_viewport()
	local s = self._gui.AbsoluteSize
	if s.X < 100 or s.Y < 100 then
		local cam = Workspace and Workspace.CurrentCamera
		if cam then return cam.ViewportSize end
		return Vector2.new(1280, 720)
	end
	return s
end

function Window:_fit(center)
	local vp = self:_viewport()
	local w = math.max(260, math.min(self._wantW, math.floor(vp.X * 0.94)))
	local h = math.max(200, math.min(self._wantH, math.floor(vp.Y * 0.94)))
	self._w, self._h = w, h
	local main = self._main
	main.Size = UDim2.fromOffset(w, self._min and M.Top or h)
	if center then
		main.Position = UDim2.fromOffset(math.floor((vp.X - w) / 2), math.floor((vp.Y - h) / 2))
	else
		local p = main.Position
		main.Position = UDim2.fromOffset(
			math.clamp(p.X.Offset, -(w - 80), vp.X - 80),
			math.clamp(p.Y.Offset, 0, vp.Y - M.Top)
		)
	end
end

-- one shared pointer-drag pipeline for mouse and touch.
-- onMove gets the pointer position; it also runs once on press so taps land immediately.
function Window:_bindDrag(handle, onBegin, onMove, onEnd)
	handle.InputBegan:Connect(function(input)
		local t = input.UserInputType
		if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then return end
		if self._drag then return end
		local d = { input = input, move = onMove, done = onEnd }
		self._drag = d
		fire(onBegin, input)
		fire(onMove, input.Position)
		local conn
		conn = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				conn:Disconnect()
				self:_endDrag(d)
			end
		end)
	end)
end

function Window:_endDrag(d)
	if self._drag ~= d then return end
	self._drag = nil
	fire(d.done)
end

-- horizontal drag over `bar`; alpha 0..1. page scrolling is locked while dragging so touch doesn't fight it
function Window:_dragX(hit, bar, page, onAlpha)
	self:_bindDrag(hit,
		function() if page then page.ScrollingEnabled = false end end,
		function(pos)
			local w = bar.AbsoluteSize.X
			if w <= 0 then return end
			onAlpha(math.clamp((pos.X - bar.AbsolutePosition.X) / w, 0, 1))
		end,
		function() if page then page.ScrollingEnabled = true end end
	)
end

function Window:_mobileButton()
	local vp = self:_viewport()
	local btn = new("TextButton", {
		Size = UDim2.fromOffset(46, 46),
		Position = UDim2.fromOffset(14, math.floor(vp.Y * 0.38)),
		AutoButtonColor = false, Text = "", BorderSizePixel = 0, Parent = self._gui,
	})
	self:_bind(btn, "BackgroundColor3", "Accent")
	corner(btn, 23)
	for i = 1, 3 do
		local bar = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, (i - 2) * 7),
			Size = UDim2.fromOffset(18, 2), BorderSizePixel = 0, Parent = btn,
		})
		self:_bind(bar, "BackgroundColor3", "Background")
		corner(bar, 1)
	end
	local moved, start, origin = false, nil, nil
	self:_bindDrag(btn,
		function(input)
			moved = false
			start = input.Position
			origin = btn.Position
		end,
		function(pos)
			if not start then return end
			local d = pos - start
			if d.Magnitude > 8 then moved = true end
			if moved then
				local v = self:_viewport()
				btn.Position = UDim2.fromOffset(
					math.clamp(origin.X.Offset + d.X, 0, v.X - 46),
					math.clamp(origin.Y.Offset + d.Y, 0, v.Y - 46)
				)
			end
		end
	)
	btn.Activated:Connect(function()
		if not moved then self:Toggle() end
	end)
	self._mobileBtn = btn
end

function Window:SetVisible(v)
	self.Visible = v and true or false
	self._main.Visible = self.Visible
end

function Window:Toggle()
	self:SetVisible(not self.Visible)
end

function Window:SetMinimized(m)
	self._min = m and true or false
	self._body.Visible = not self._min
	tween(self._main, { Size = UDim2.fromOffset(self._w, self._min and M.Top or self._h) })
end

function Window:SetTitle(text)
	self._title.Text = text
end

----------------------------------------------------------------------
-- window: tabs
----------------------------------------------------------------------
function Window:_paintTabs()
	for _, tab in ipairs(self._tabs) do
		local on = tab == self._active
		tab._page.Visible = on
		tween(tab._btn, { TextColor3 = on and self.Theme.Text or self.Theme.SubText })
		tween(tab._line, { BackgroundTransparency = on and 0 or 1 })
	end
end

function Window:AddTab(opts)
	if type(opts) == "string" then opts = { Name = opts } end
	opts = opts or {}
	local name = tostring(opts.Name or "Tab")
	local tab = setmetatable({ Window = self, Name = name, _n = 0 }, Container)

	local btn = new("TextButton", {
		AutoButtonColor = false, BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 1, 0),
		Text = name, Font = F.Bold, TextSize = M.Text, TextColor3 = self.Theme.SubText,
		LayoutOrder = #self._tabs + 1, Parent = self._tabBar,
	})
	padding(btn, 12, 0)
	local line = new("Frame", {
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 2), BorderSizePixel = 0, BackgroundTransparency = 1, Parent = btn,
	})
	self:_bind(line, "BackgroundColor3", "Accent")

	local page = new("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Visible = false,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = TOUCH and 3 or 4, Parent = self._pages,
	})
	self:_bind(page, "ScrollBarImageColor3", "Track")
	vlist(page, 6)
	padding(page, 10, 10)

	tab._parent, tab._page, tab._btn, tab._line = page, page, btn, line
	btn.Activated:Connect(function() self:SelectTab(tab) end)
	self._tabs[#self._tabs + 1] = tab
	if not self._active then self:SelectTab(tab) end
	return tab
end

function Window:SelectTab(t)
	if type(t) == "string" then
		for _, x in ipairs(self._tabs) do
			if x.Name == t then t = x break end
		end
	end
	if type(t) ~= "table" then return end
	self._active = t
	self:_paintTabs()
end

----------------------------------------------------------------------
-- window: notifications
----------------------------------------------------------------------
local NOTIFY_KEYS = { info = "Accent", success = "Success", warning = "Warning", error = "Danger" }

function Window:Notify(o)
	if self._destroyed then return end
	if type(o) == "string" then o = { Content = o } end
	o = o or {}
	local th = self.Theme
	local color = th[NOTIFY_KEYS[o.Type or "info"] or "Accent"]
	local dur = o.Duration or 4

	local wrap = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, Parent = self._notifs,
	})
	local card = new("TextButton", {
		AutoButtonColor = false, Text = "", BackgroundColor3 = th.Surface, BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.new(1, 40, 0, 0), Parent = wrap,
	})
	corner(card, R.Card)
	new("UIStroke", { Color = th.Stroke, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = card })

	local mark = new("Frame", {
		Position = UDim2.fromOffset(8, 10), Size = UDim2.new(0, 3, 1, -20),
		BackgroundColor3 = color, BorderSizePixel = 0, Parent = card,
	})
	corner(mark, 2)

	local inner = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, Parent = card,
	})
	new("UIPadding", {
		PaddingLeft = UDim.new(0, 20), PaddingRight = UDim.new(0, 12),
		PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), Parent = inner,
	})
	vlist(inner, 3)

	local function text(str, font, col, order)
		new("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
			Text = str, Font = font, TextSize = M.Text, TextColor3 = col, LayoutOrder = order, Parent = inner,
		})
	end
	if o.Title and o.Title ~= "" then text(o.Title, F.Bold, th.Text, 1) end
	if o.Content and o.Content ~= "" then text(o.Content, F.Regular, th.SubText, 2) end

	local prog = new("Frame", {
		Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = color, BorderSizePixel = 0,
		LayoutOrder = 3, Parent = inner,
	})
	corner(prog, 1)

	tween(card, { Position = UDim2.new(0, 0, 0, 0) }, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))
	tween(prog, { Size = UDim2.new(0, 0, 0, 2) }, TweenInfo.new(dur, Enum.EasingStyle.Linear))

	local dead = false
	local function dismiss()
		if dead or self._destroyed then return end
		dead = true
		tween(card, { Position = UDim2.new(1, 40, 0, 0) }, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In))
		task.delay(0.22, function() wrap:Destroy() end)
	end
	card.Activated:Connect(dismiss)
	task.delay(dur, dismiss)
end

----------------------------------------------------------------------
-- window: configs (needs executor filesystem functions)
----------------------------------------------------------------------
function Window:_cfgPath(name)
	return self.Folder .. "/" .. name .. ".json"
end

function Window:SaveConfig(name)
	if not fsReady() then return false, "this executor has no filesystem api" end
	if not name or name == "" then return false, "config needs a name" end
	local data = {}
	for flag, val in pairs(self.Flags) do data[flag] = encodeValue(val) end
	local ok, err = pcall(function()
		if not isfolder(self.Folder) then makefolder(self.Folder) end
		writefile(self:_cfgPath(name), HttpService:JSONEncode(data))
	end)
	return ok, err
end

function Window:LoadConfig(name)
	if not fsReady() then return false, "this executor has no filesystem api" end
	local path = self:_cfgPath(name)
	if not isfile(path) then return false, "no config named " .. tostring(name) end
	local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
	if not ok or type(data) ~= "table" then return false, "config file is unreadable" end
	for flag, raw in pairs(data) do
		local set = self._setters[flag]
		if set then
			pcall(function() set(decodeValue(raw)) end)
		end
	end
	return true
end

function Window:DeleteConfig(name)
	if not (delfile and isfile) then return false, "this executor has no delfile" end
	local path = self:_cfgPath(name)
	if not isfile(path) then return false, "no config named " .. tostring(name) end
	return pcall(delfile, path)
end

function Window:ListConfigs()
	local out = {}
	if not (listfiles and isfolder) then return out end
	local ok, files = pcall(function()
		if not isfolder(self.Folder) then return {} end
		return listfiles(self.Folder)
	end)
	if ok and type(files) == "table" then
		for _, f in ipairs(files) do
			local n = tostring(f):match("([^/\\]+)%.json$")
			if n then out[#out + 1] = n end
		end
	end
	table.sort(out)
	return out
end

----------------------------------------------------------------------
-- window: built-in settings tab
----------------------------------------------------------------------
function Window:AddSettingsTab()
	local tab = self:AddTab("Settings")

	local ui = tab:AddSection("Interface")
	local names = {}
	for n in pairs(Themes) do names[#names + 1] = n end
	table.sort(names)
	local accent
	ui:AddDropdown({
		Name = "Theme", Options = names, Default = self.ThemeName,
		Callback = function(n)
			self:SetTheme(n)
			if accent then accent:Set(self.Theme.Accent, true) end
		end,
	})
	accent = ui:AddColorPicker({
		Name = "Accent", Default = self.Theme.Accent,
		Callback = function(c) self:SetAccent(c) end,
	})
	ui:AddKeybind({
		Name = "Menu key", Default = self.ToggleKey,
		OnChanged = function(k)
			if k ~= Enum.KeyCode.Unknown then self.ToggleKey = k end
		end,
	})
	ui:AddButton({ Name = "Unload interface", Callback = function() self:Destroy() end })

	local cfg = tab:AddSection("Configs")
	local nameBox = cfg:AddInput({ Name = "Name", Placeholder = "default" })
	local saved = cfg:AddDropdown({ Name = "Saved", Options = self:ListConfigs() })

	local function result(ok, err, good)
		self:Notify({
			Title = ok and good or "That didn't work",
			Content = ok and "" or tostring(err),
			Type = ok and "success" or "error",
		})
	end

	cfg:AddButton({ Name = "Save", Callback = function()
		local n = nameBox:Get()
		if n == "" then n = saved:Get() or "default" end
		local ok, err = self:SaveConfig(n)
		result(ok, err, "Saved " .. n)
		saved:Refresh(self:ListConfigs(), true)
	end })
	cfg:AddButton({ Name = "Load", Callback = function()
		local n = saved:Get()
		if not n then return result(false, "pick a saved config first") end
		local ok, err = self:LoadConfig(n)
		result(ok, err, "Loaded " .. n)
	end })
	cfg:AddButton({ Name = "Delete", Callback = function()
		local n = saved:Get()
		if not n then return result(false, "pick a saved config first") end
		local ok, err = self:DeleteConfig(n)
		result(ok, err, "Deleted " .. n)
		saved:Refresh(self:ListConfigs())
	end })
	cfg:AddButton({ Name = "Refresh list", Callback = function()
		saved:Refresh(self:ListConfigs(), true)
	end })
	return tab
end

function Window:Destroy()
	if self._destroyed then return end
	self._destroyed = true
	self._maid:Clean()
	if genv.__veil == self then genv.__veil = nil end
end

