function Container:_order()
	self._n = self._n + 1
	return self._n
end

function Container:_card(h)
	local win = self.Window
	local f = new("Frame", {
		Size = UDim2.new(1, 0, 0, h or M.Row), BorderSizePixel = 0,
		LayoutOrder = self:_order(), Parent = self._parent,
	})
	win:_bind(f, "BackgroundColor3", "Elevated")
	corner(f, R.Card)
	win:_bind(stroke(f, 1, 0.45), "Color", "Stroke")
	return f
end

-- expandable card: header row + body that grows below it
function Container:_expander()
	local win = self.Window
	local card = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BorderSizePixel = 0,
		ClipsDescendants = true, LayoutOrder = self:_order(), Parent = self._parent,
	})
	win:_bind(card, "BackgroundColor3", "Elevated")
	corner(card, R.Card)
	win:_bind(stroke(card, 1, 0.45), "Color", "Stroke")
	vlist(card, 0)
	local head = new("TextButton", {
		BackgroundTransparency = 1, AutoButtonColor = false, Text = "",
		Size = UDim2.new(1, 0, 0, M.Row), LayoutOrder = 1, Parent = card,
	})
	return card, head
end

