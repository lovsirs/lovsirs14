--[[
	veil - ui library for roblox executors
	pc + touch. single file, zero dependencies.

	local Veil = loadstring(readfile("veil.lua"))()
	local Win  = Veil:CreateWindow({ Title = "hub", Subtitle = "v1" })
	local Tab  = Win:AddTab("Main")
	local Sec  = Tab:AddSection("Player")
	Sec:AddToggle({ Name = "Enabled", Flag = "on", Callback = function(v) end })
	Win:AddSettingsTab()

	CreateWindow options
		Title, Subtitle, Theme ("Ink" | "Graphite" | "Paper"), Accent (Color3),
		Size (Vector2), ToggleKey (KeyCode), MobileButton (bool, auto on touch-only devices),
		ConfigFolder (string), AllowPlayerGui (bool, default true)

	elements (on a Tab or a Section)
		AddLabel(text)                                  :Set(text)
		AddParagraph({Title, Content})                  :Set(title, content)
		AddButton({Name, Callback})                     :Fire() :SetText(t)
		AddToggle({Name, Default, Flag, Callback})      :Set(v) :Get()
		AddSlider({Name, Min, Max, Default, Increment, Suffix, Flag, Callback})
		AddDropdown({Name, Options, Default, Multi, Flag, Callback})   :Set :Get :Refresh(list, keep)
		AddInput({Name, Default, Placeholder, Numeric, Flag, Callback})
		AddKeybind({Name, Default, Mode = "Press" | "Hold" | "Toggle", Flag, Callback, OnChanged})
		AddColorPicker({Name, Default, Flag, Callback})
		AddDivider()
		AddSection(name)  -> a container with the same Add* methods

	window
		:AddTab :SelectTab :Notify({Title, Content, Type, Duration}) :Toggle :SetVisible
		:SetMinimized :SetTitle :SetTheme :SetAccent :AddSettingsTab
		:SaveConfig :LoadConfig :DeleteConfig :ListConfigs :Destroy
		.Flags holds the live value of every element that was given a Flag
]]

