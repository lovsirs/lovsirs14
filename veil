----------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------
local function copyTheme(t)
	local c = {}
	for k, v in pairs(t) do c[k] = v end
	return c
end

local function rstr(n)
	local cs = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
	local out = {}
	for i = 1, n do
		local k = math.random(1, #cs)
		out[i] = cs:sub(k, k)
	end
	return table.concat(out)
end

-- user callbacks never take the library down, and nothing is printed unless Veil.Debug
local function fire(cb, ...)
	if type(cb) ~= "function" then return end
	local ok, err = pcall(cb, ...)
	if not ok and Veil.Debug then warn("[veil] " .. tostring(err)) end
end

local function new(class, props)
	local inst = Instance.new(class)
	local parent
	for k, v in pairs(props) do
		if k == "Parent" then parent = v else inst[k] = v end
	end
	if parent then inst.Parent = parent end -- parent last, one replication step
	return inst
end

local function corner(parent, r)
	return new("UICorner", { CornerRadius = UDim.new(0, r), Parent = parent })
end

local function stroke(parent, thickness, transparency)
	return new("UIStroke", {
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

local function padding(parent, x, y)
	y = y or x
	return new("UIPadding", {
		PaddingLeft = UDim.new(0, x), PaddingRight = UDim.new(0, x),
		PaddingTop = UDim.new(0, y), PaddingBottom = UDim.new(0, y),
		Parent = parent,
	})
end

local function vlist(parent, gap)
	return new("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, gap or 0),
		Parent = parent,
	})
end

local function tween(inst, props, info)
	local t = TweenService:Create(inst, info or EASE, props)
	t:Play()
	return t
end

local function snap(v, inc)
	local r = math.floor(v / inc + 0.5) * inc
	local dec = #((tostring(inc):match("%.(%d+)")) or "")
	return tonumber(string.format("%." .. dec .. "f", r))
end

local function newMaid()
	local m = { _items = {} }
	function m:Add(x)
		self._items[#self._items + 1] = x
		return x
	end
	function m:Clean()
		local items = self._items
		self._items = {}
		for _, x in ipairs(items) do
			local t = typeof(x)
			if t == "RBXScriptConnection" then
				pcall(function() x:Disconnect() end)
			elseif t == "Instance" then
				pcall(function() x:Destroy() end)
			elseif type(x) == "function" then
				pcall(x)
			end
		end
	end
	return m
end

-- config values -> json-safe values and back
local function encodeValue(v)
	local t = typeof(v)
	if t == "Color3" then return { __t = "c3", r = v.R, g = v.G, b = v.B } end
	if t == "EnumItem" then return { __t = "key", name = v.Name } end
	return v
end

local function decodeValue(v)
	if type(v) == "table" then
		if v.__t == "c3" then return Color3.new(v.r, v.g, v.b) end
		if v.__t == "key" then return Enum.KeyCode[v.name] end
	end
	return v
end

local function fsReady()
	return (writefile and readfile and isfile and isfolder and makefolder) and true or false
end

-- hidden container first (gethui), then CoreGui, PlayerGui only as a last resort
local function mount(gui, allowPlayerGui)
	if syn and syn.protect_gui then pcall(syn.protect_gui, gui) end
	local targets = {}
	if gethui then
		local ok, h = pcall(gethui)
		if ok and h then targets[#targets + 1] = h end
	end
	if CoreGui then targets[#targets + 1] = CoreGui end
	if allowPlayerGui and Players and Players.LocalPlayer then
		local pg = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
		if pg then targets[#targets + 1] = pg end
	end
	for _, t in ipairs(targets) do
		local ok = pcall(function() gui.Parent = t end)
		if ok and gui.Parent == t then return t end
	end
	return nil
end

