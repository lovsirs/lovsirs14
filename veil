function Container:AddToggle(o)
	o = o or {}
	local win = self.Window
	local state = o.Default == true
	local card = self:_card()
	local btn = new("TextButton", {
		BackgroundTransparency = 1, AutoButtonColor = false, Text = "",
		Size = UDim2.fromScale(1, 1), Parent = card,
	})
	win:_label(btn, o.Name or "Toggle", { Size = UDim2.new(1, -66, 1, 0) })
	local track = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(38, 20), BorderSizePixel = 0, Parent = btn,
	})
	corner(track, 10)
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 2, 0.5, 0),
		Size = UDim2.fromOffset(16, 16), BorderSizePixel = 0,
		BackgroundColor3 = Color3.new(1, 1, 1), Parent = track,
	})
	corner(knob, 8)

	local function paint(animate)
		local th = win.Theme
		local col = state and th.Accent or th.Track
		local pos = state and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
		if animate then
			tween(track, { BackgroundColor3 = col })
			tween(knob, { Position = pos })
		else
			track.BackgroundColor3 = col
			knob.Position = pos
		end
	end

	local obj = {}
	function obj:Set(v, silent)
		state = v and true or false
		paint(true)
		if o.Flag then win.Flags[o.Flag] = state end
		if not silent then fire(o.Callback, state) end
	end
	function obj:Get() return state end

	btn.Activated:Connect(function() obj:Set(not state) end)
	win:_hook(function() paint(false) end)
	paint(false)
	if o.Flag then
		win.Flags[o.Flag] = state
		win._setters[o.Flag] = function(v) obj:Set(v) end
	end
	return obj
end

function Container:AddSlider(o)
	o = o or {}
	local win = self.Window
	local min, max = o.Min or 0, o.Max or 100
	local inc = o.Increment or 1
	local suffix = o.Suffix or ""
	local value = math.clamp(snap(o.Default or min, inc), min, max)
	local H = M.Row + 16
	local card = self:_card(H)

	win:_label(card, o.Name or "Slider", { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(0.6, -12, 0, 22) })
	local valLbl = win:_label(card, "", {
		Position = UDim2.new(0.6, 0, 0, 6), Size = UDim2.new(0.4, -12, 0, 22),
		Align = Enum.TextXAlignment.Right, Color = "SubText",
	})

	local bar = new("Frame", {
		Position = UDim2.new(0, 12, 1, -16), Size = UDim2.new(1, -24, 0, 6), BorderSizePixel = 0, Parent = card,
	})
	win:_bind(bar, "BackgroundColor3", "Track")
	corner(bar, 3)
	local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, Parent = bar })
	win:_bind(fill, "BackgroundColor3", "Accent")
	corner(fill, 3)
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(12, 12),
		BorderSizePixel = 0, BackgroundColor3 = Color3.new(1, 1, 1), Parent = bar,
	})
	corner(knob, 6)
	local hit = new("TextButton", {
		BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
		Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 1, -26), Parent = card,
	})

	local function render()
		local a = (max > min) and (value - min) / (max - min) or 0
		fill.Size = UDim2.fromScale(a, 1)
		knob.Position = UDim2.fromScale(a, 0.5)
		valLbl.Text = tostring(value) .. suffix
	end

	local obj = {}
	function obj:Set(v, silent)
		value = math.clamp(snap(tonumber(v) or min, inc), min, max)
		render()
		if o.Flag then win.Flags[o.Flag] = value end
		if not silent then fire(o.Callback, value) end
	end
	function obj:Get() return value end

	win:_dragX(hit, bar, self._page, function(a)
		local v = math.clamp(snap(min + (max - min) * a, inc), min, max)
		if v ~= value then obj:Set(v) end
	end)

	render()
	if o.Flag then
		win.Flags[o.Flag] = value
		win._setters[o.Flag] = function(v) obj:Set(v) end
	end
	return obj
end

function Container:AddDropdown(o)
	o = o or {}
	local win = self.Window
	local multi = o.Multi == true
	local options = o.Options or {}
	local OPT = M.Row - 6
	local MAXV = 5
	local open = false
	local selected
	if multi then
		selected = {}
		if type(o.Default) == "table" then
			for _, d in ipairs(o.Default) do selected[d] = true end
		end
	else
		selected = o.Default
	end

	local card, head = self:_expander()
	win:_label(head, o.Name or "Dropdown", { Size = UDim2.new(0.5, -12, 1, 0) })
	local valLbl = win:_label(head, "", {
		Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(0.5, -34, 1, 0),
		Align = Enum.TextXAlignment.Right, Color = "SubText",
	})
	local arrow = win:_label(head, "v", {
		Position = UDim2.new(1, -28, 0, 0), Size = UDim2.fromOffset(16, M.Row),
		Align = Enum.TextXAlignment.Center, Color = "SubText", Font = F.Bold,
	})

	local holder = new("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 0),
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 3, LayoutOrder = 2, Parent = card,
	})
	win:_bind(holder, "ScrollBarImageColor3", "Track")
	vlist(holder, 2)
	padding(holder, 6, 4)

	local btns = {}
	local setOpen

	local function isSel(opt)
		if multi then return selected[opt] == true end
		return selected == opt
	end
	local function getValue()
		if multi then
			local t = {}
			for _, opt in ipairs(options) do
				if selected[opt] then t[#t + 1] = opt end
			end
			return t
		end
		return selected
	end
	local function display()
		if multi then
			local t = {}
			for _, opt in ipairs(options) do
				if selected[opt] then t[#t + 1] = tostring(opt) end
			end
			return #t > 0 and table.concat(t, ", ") or "None"
		end
		return selected ~= nil and tostring(selected) or "None"
	end
	local function listH()
		return math.min(#options, MAXV) * (OPT + 2) + 8
	end
	local function paint()
		local th = win.Theme
		for opt, b in pairs(btns) do
			local sel = isSel(opt)
			b.TextColor3 = sel and th.Accent or th.Text
			b.Font = sel and F.Bold or F.Regular
		end
		valLbl.Text = display()
	end

	local function pick(opt)
		if multi then
			if selected[opt] then selected[opt] = nil else selected[opt] = true end
		else
			selected = opt
		end
		paint()
		if o.Flag then win.Flags[o.Flag] = getValue() end
		fire(o.Callback, getValue())
		if not multi then setOpen(false) end
	end

	local function build()
		for _, b in pairs(btns) do b:Destroy() end
		btns = {}
		for i, opt in ipairs(options) do
			local b = new("TextButton", {
				AutoButtonColor = false, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, OPT),
				Text = tostring(opt), Font = F.Regular, TextSize = M.Text, LayoutOrder = i, Parent = holder,
			})
			win:_bind(b, "BackgroundColor3", "Surface")
			corner(b, R.Control)
			b.Activated:Connect(function() pick(opt) end)
			btns[opt] = b
		end
		paint()
		if open then holder.Size = UDim2.new(1, 0, 0, listH()) end
	end

	setOpen = function(v)
		open = v
		tween(holder, { Size = UDim2.new(1, 0, 0, v and listH() or 0) })
		tween(arrow, { Rotation = v and 180 or 0 })
	end
	head.Activated:Connect(function() setOpen(not open) end)

	local obj = {}
	function obj:Set(v, silent)
		if multi then
			selected = {}
			if type(v) == "table" then
				for _, x in ipairs(v) do selected[x] = true end
			end
		else
			selected = v
		end
		paint()
		if o.Flag then win.Flags[o.Flag] = getValue() end
		if not silent then fire(o.Callback, getValue()) end
	end
	function obj:Get() return getValue() end
	function obj:Refresh(list, keep)
		options = list or {}
		if not keep then selected = multi and {} or nil end
		build()
		if o.Flag then win.Flags[o.Flag] = getValue() end
	end

	win:_hook(paint)
	build()
	if o.Flag then
		win.Flags[o.Flag] = getValue()
		win._setters[o.Flag] = function(v) obj:Set(v) end
	end
	return obj
end

function Container:AddInput(o)
	o = o or {}
	local win = self.Window
	local card = self:_card()
	win:_label(card, o.Name or "Input", { Size = UDim2.new(0.5, -12, 1, 0) })
	local box = new("TextBox", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.new(0.45, 0, 1, -12), BorderSizePixel = 0, ClearTextOnFocus = false,
		ClipsDescendants = true, Text = o.Default or "", PlaceholderText = o.Placeholder or "",
		Font = F.Regular, TextSize = M.Text, TextXAlignment = Enum.TextXAlignment.Left, Parent = card,
	})
	win:_bind(box, "BackgroundColor3", "Surface")
	win:_bind(box, "TextColor3", "Text")
	win:_bind(box, "PlaceholderColor3", "SubText")
	corner(box, R.Control)
	padding(box, 8, 0)

	local function getValue()
		if o.Numeric then return tonumber(box.Text) end
		return box.Text
	end
	if o.Numeric then
		box:GetPropertyChangedSignal("Text"):Connect(function()
			local clean = box.Text:gsub("[^%d%.%-]", "")
			if clean ~= box.Text then box.Text = clean end
		end)
	end
	box.FocusLost:Connect(function(enter)
		local v = getValue()
		if o.Flag then win.Flags[o.Flag] = v end
		fire(o.Callback, v, enter)
	end)

	local obj = {}
	function obj:Set(t, silent)
		box.Text = tostring(t == nil and "" or t)
		local v = getValue()
		if o.Flag then win.Flags[o.Flag] = v end
		if not silent then fire(o.Callback, v, false) end
	end
	function obj:Get() return getValue() end

	if o.Flag then
		win.Flags[o.Flag] = getValue()
		win._setters[o.Flag] = function(v) obj:Set(v) end
	end
	return obj
end

function Container:AddKeybind(o)
	o = o or {}
	local win = self.Window
	local key = o.Default or Enum.KeyCode.Unknown
	local mode = o.Mode or "Press"
	local listening = false
	local active = false

	local card = self:_card()
	win:_label(card, o.Name or "Keybind", { Size = UDim2.new(1, -124, 1, 0) })
	local btn = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(100, M.Row - 12), BorderSizePixel = 0, AutoButtonColor = false,
		Text = "", Font = F.Regular, TextSize = M.Text - 1, TextTruncate = Enum.TextTruncate.AtEnd, Parent = card,
	})
	win:_bind(btn, "BackgroundColor3", "Surface")
	win:_bind(btn, "TextColor3", "Text")
	corner(btn, R.Control)

	local function caption()
		if listening then return "press a key" end
		return key == Enum.KeyCode.Unknown and "None" or key.Name
	end
	local function setKey(k)
		key = k
		btn.Text = caption()
		if o.Flag then win.Flags[o.Flag] = key end
	end
	btn.Text = caption()

	btn.Activated:Connect(function()
		listening = true
		win._rebinding = true
		btn.Text = caption()
	end)

	win._maid:Add(UIS.InputBegan:Connect(function(input, gp)
		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				listening = false
				setKey(input.KeyCode == Enum.KeyCode.Escape and Enum.KeyCode.Unknown or input.KeyCode)
				-- defer so the window's own toggle handler doesn't see this same keypress
				task.defer(function() win._rebinding = false end)
				fire(o.OnChanged, key)
			end
			return
		end
		if gp or key == Enum.KeyCode.Unknown then return end
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == key then
			if mode == "Toggle" then
				active = not active
				fire(o.Callback, active)
			elseif mode == "Hold" then
				active = true
				fire(o.Callback, true)
			else
				fire(o.Callback)
			end
		end
	end))
	win._maid:Add(UIS.InputEnded:Connect(function(input)
		if mode == "Hold" and active and input.KeyCode == key then
			active = false
			fire(o.Callback, false)
		end
	end))

	local obj = {}
	function obj:Set(k, silent)
		if typeof(k) ~= "EnumItem" then return end
		setKey(k)
		if not silent then fire(o.OnChanged, key) end
	end
	function obj:Get() return key end
	function obj:GetState() return active end

	if o.Flag then
		win.Flags[o.Flag] = key
		win._setters[o.Flag] = function(v) obj:Set(v) end
	end
	return obj
end

function Container:AddColorPicker(o)
	o = o or {}
	local win = self.Window
	local hue, sat, val = Color3.toHSV(o.Default or Color3.fromRGB(255, 255, 255))
	local BAR = TOUCH and 16 or 12
	local ROW = TOUCH and 34 or 28
	local PANEL = ROW * 3 + 12
	local open = false

	local card, head = self:_expander()
	win:_label(head, o.Name or "Color", { Size = UDim2.new(1, -70, 1, 0) })
	local swatch = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(34, M.Row - 16), BorderSizePixel = 0, Parent = head,
	})
	corner(swatch, R.Control)
	win:_bind(stroke(swatch, 1, 0.3), "Color", "Stroke")

	local panel = new("Frame", {
		BackgroundTransparency = 1, ClipsDescendants = true, Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = 2, Parent = card,
	})

	-- three horizontal gradient bars (hue / saturation / value): big touch targets, no 2d picking
	local function makeBar(i)
		local top = 6 + (i - 1) * ROW
		local bar = new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
			Position = UDim2.new(0, 12, 0, top + (ROW - BAR) / 2), Size = UDim2.new(1, -24, 0, BAR), Parent = panel,
		})
		corner(bar, BAR / 2)
		local grad = new("UIGradient", { Parent = bar })
		local cur = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(0, 8, 1, 8),
			BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = bar,
		})
		corner(cur, 4)
		stroke(cur, 1.5).Color = Color3.new(0, 0, 0)
		local hit = new("TextButton", {
			BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
			Position = UDim2.fromOffset(0, top), Size = UDim2.new(1, 0, 0, ROW), Parent = panel,
		})
		return bar, grad, cur, hit
	end
	local hueBar, hueGrad, hueCur, hueHit = makeBar(1)
	local satBar, satGrad, satCur, satHit = makeBar(2)
	local valBar, valGrad, valCur, valHit = makeBar(3)
	hueGrad.Color = RAINBOW

	local function render()
		local c = Color3.fromHSV(hue, sat, val)
		swatch.BackgroundColor3 = c
		hueCur.Position = UDim2.new(hue, 0, 0.5, 0)
		satCur.Position = UDim2.new(sat, 0, 0.5, 0)
		valCur.Position = UDim2.new(val, 0, 0.5, 0)
		satGrad.Color = ColorSequence.new(Color3.fromHSV(hue, 0, val), Color3.fromHSV(hue, 1, val))
		valGrad.Color = ColorSequence.new(Color3.new(0, 0, 0), Color3.fromHSV(hue, sat, 1))
		return c
	end
	local function emit()
		local c = render()
		if o.Flag then win.Flags[o.Flag] = c end
		fire(o.Callback, c)
	end

	win:_dragX(hueHit, hueBar, self._page, function(a) hue = math.min(a, 0.9999) emit() end)
	win:_dragX(satHit, satBar, self._page, function(a) sat = a emit() end)
	win:_dragX(valHit, valBar, self._page, function(a) val = a emit() end)

	head.Activated:Connect(function()
		open = not open
		tween(panel, { Size = UDim2.new(1, 0, 0, open and PANEL or 0) })
	end)

	local obj = {}
	function obj:Set(c, silent)
		hue, sat, val = Color3.toHSV(c)
		local col = render()
		if o.Flag then win.Flags[o.Flag] = col end
		if not silent then fire(o.Callback, col) end
	end
	function obj:Get() return Color3.fromHSV(hue, sat, val) end

	local first = render()
	if o.Flag then
		win.Flags[o.Flag] = first
		win._setters[o.Flag] = function(v) obj:Set(v) end
	end
	return obj
end

----------------------------------------------------------------------
-- entry point
----------------------------------------------------------------------
function Veil:CreateWindow(opts)
	opts = opts or {}
	-- one window at a time: re-executing replaces the old one instead of stacking
	if genv.__veil then pcall(function() genv.__veil:Destroy() end) end

	local self = setmetatable({}, Window)
	self.Flags     = {}
	self._setters  = {}
	self._hooks    = {}
	self._themed   = setmetatable({}, { __mode = "k" })
	self._maid     = newMaid()
	self._tabs     = {}
	self._min      = false
	self.Folder    = opts.ConfigFolder or "veil"
	self.ToggleKey = opts.ToggleKey or Enum.KeyCode.RightShift
	self.Visible   = true
	self.ThemeName = Themes[opts.Theme or ""] and opts.Theme or DEFAULT_THEME
	self.Theme     = copyTheme(Themes[self.ThemeName])
	if typeof(opts.Accent) == "Color3" then self.Theme.Accent = opts.Accent end

	local want = opts.Size or Vector2.new(600, 420)
	self._wantW, self._wantH = want.X, want.Y

	local gui = new("ScreenGui", {
		Name = rstr(math.random(10, 18)),
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999999,
	})
	self._gui = gui
	if not mount(gui, opts.AllowPlayerGui ~= false) then
		gui:Destroy()
		error("[veil] no usable gui parent (gethui and CoreGui both blocked)", 2)
	end
	self._maid:Add(gui)

	-- window frame
	local main = new("Frame", {
		Size = UDim2.fromOffset(600, 420), BorderSizePixel = 0,
		ClipsDescendants = true, Active = true, Parent = gui,
	})
	self:_bind(main, "BackgroundColor3", "Background")
	corner(main, R.Window)
	self:_bind(stroke(main, 1), "Color", "Stroke")
	self._main = main

	-- title bar
	local top = new("Frame", { Size = UDim2.new(1, 0, 0, M.Top), BorderSizePixel = 0, Parent = main })
	self:_bind(top, "BackgroundColor3", "Surface")
	corner(top, R.Window)
	local topFill = new("Frame", {
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, R.Window), BorderSizePixel = 0, Parent = top,
	})
	self:_bind(topFill, "BackgroundColor3", "Surface")
	local topLine = new("Frame", {
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 1), BorderSizePixel = 0, Parent = top,
	})
	self:_bind(topLine, "BackgroundColor3", "Stroke")

	local titleBox = new("Frame", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(1, -90, 1, 0), Parent = top,
	})
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8), Parent = titleBox,
	})
	local title = new("TextLabel", {
		BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 1, 0),
		Text = opts.Title or "veil", Font = F.Bold, TextSize = M.Text + 2, LayoutOrder = 1, Parent = titleBox,
	})
	self:_bind(title, "TextColor3", "Text")
	self._title = title
	local sub = new("TextLabel", {
		BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 1, 0),
		Text = opts.Subtitle or "", Font = F.Regular, TextSize = M.Text, LayoutOrder = 2, Parent = titleBox,
	})
	self:_bind(sub, "TextColor3", "SubText")

	local function topBtn(text, fromRight, hover)
		local b = new("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -fromRight, 0.5, 0),
			Size = UDim2.fromOffset(M.Top - 8, M.Top - 12), BackgroundTransparency = 1,
			AutoButtonColor = false, Text = text, Font = F.Bold, TextSize = 18, Parent = top,
		})
		self:_bind(b, "TextColor3", "SubText")
		b.MouseEnter:Connect(function() tween(b, { TextColor3 = self.Theme[hover] }) end)
		b.MouseLeave:Connect(function() tween(b, { TextColor3 = self.Theme.SubText }) end)
		return b
	end
	local closeBtn = topBtn("\u{00D7}", 6, "Danger")
	local minBtn = topBtn("\u{2013}", 6 + M.Top - 8, "Text")
	closeBtn.Activated:Connect(function() self:SetVisible(false) end)
	minBtn.Activated:Connect(function() self:SetMinimized(not self._min) end)

	-- window drag
	local dragStart, dragOrigin
	self:_bindDrag(top,
		function(input)
			dragStart = input.Position
			dragOrigin = main.Position
		end,
		function(pos)
			if not dragStart then return end
			local d = pos - dragStart
			local vp = self:_viewport()
			main.Position = UDim2.fromOffset(
				math.clamp(dragOrigin.X.Offset + d.X, -(self._w - 80), vp.X - 80),
				math.clamp(dragOrigin.Y.Offset + d.Y, 0, vp.Y - M.Top)
			)
		end
	)

	-- body: tab strip + pages
	local body = new("Frame", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(0, M.Top),
		Size = UDim2.new(1, 0, 1, -M.Top), Parent = main,
	})
	self._body = body

	local tabBar = new("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, M.Tab),
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X, ScrollBarThickness = 0, Parent = body,
	})
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 2), Parent = tabBar,
	})
	padding(tabBar, 8, 0)
	self._tabBar = tabBar

	local tabLine = new("Frame", {
		Position = UDim2.fromOffset(0, M.Tab), Size = UDim2.new(1, 0, 0, 1), BorderSizePixel = 0, Parent = body,
	})
	self:_bind(tabLine, "BackgroundColor3", "Stroke")

	self._pages = new("Frame", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(0, M.Tab + 1),
		Size = UDim2.new(1, 0, 1, -(M.Tab + 1)), ClipsDescendants = true, Parent = body,
	})
	self:_hook(function() self:_paintTabs() end)

	-- notifications
	local notifs = new("Frame", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.new(0, TOUCH and 230 or 280, 1, -24), Parent = gui,
	})
	new("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8),
		HorizontalAlignment = Enum.HorizontalAlignment.Right, Parent = notifs,
	})
	self._notifs = notifs

	-- shared pointer plumbing (one connection each, however many sliders exist)
	self._maid:Add(UIS.InputChanged:Connect(function(input)
		local d = self._drag
		if not d then return end
		local a, t = d.input.UserInputType, input.UserInputType
		if a == Enum.UserInputType.MouseButton1 then
			if not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
				self:_endDrag(d)
			elseif t == Enum.UserInputType.MouseMovement then
				fire(d.move, input.Position)
			end
		elseif a == Enum.UserInputType.Touch and input == d.input then
			fire(d.move, input.Position)
		end
	end))
	self._maid:Add(UIS.InputEnded:Connect(function(input)
		local d = self._drag
		if d and d.input.UserInputType == Enum.UserInputType.MouseButton1
			and input.UserInputType == Enum.UserInputType.MouseButton1 then
			self:_endDrag(d)
		end
	end))

	-- pc: toggle key. mobile: floating button.
	self._maid:Add(UIS.InputBegan:Connect(function(input, gp)
		if gp or self._rebinding then return end
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == self.ToggleKey then
			self:Toggle()
		end
	end))
	local wantBtn = opts.MobileButton
	if wantBtn == nil then wantBtn = UIS.TouchEnabled and not UIS.KeyboardEnabled end
	if wantBtn then self:_mobileButton() end

	-- keep the window on screen when the viewport changes (rotation, resize)
	self._maid:Add(gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() self:_fit() end))
	self:_fit(true)

	genv.__veil = self
	return self
end

return Veil
